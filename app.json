{
  "expo": {
    "name": "Redup",
    "slug": "redup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "redup",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.redup.mobile",
      "associatedDomains": [
        "applinks:redup.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.redup.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#5B4BE8",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "redup.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0C14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Redup necesita acceso a tus fotos para elegir tu avatar y compartir imágenes.",
          "cameraPermission": "Redup necesita acceso a la cámara para tomar fotos en el chat."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Redup necesita acceso al micrófono para grabar notas de voz."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5B4BE8",
          "defaultChannel": "messages"
        }
      ],
      "./plugins/with-android-sdk",
      "expo-secure-store",
      "expo-asset",
      "@livekit/react-native-expo-plugin",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Redup necesita acceso a tus fotos para guardar imágenes en tu galería.",
          "savePhotosPermission": "Redup necesita permiso para guardar imágenes en tu galería."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "2e169d4e-b200-41d9-9c12-9c984ebfb65b"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
