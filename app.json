{
  "expo": {
    "name": "Redup",
    "slug": "redup",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "redup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.redup.mobile"
    },
    "android": {
      "package": "app.redup.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#5B4BE8",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0C14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Redup necesita acceso a tus fotos para elegir tu avatar y compartir imágenes.",
          "cameraPermission": "Redup necesita acceso a la cámara para tomar fotos en el chat."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Redup necesita acceso al micrófono para grabar notas de voz."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#5B4BE8"
        }
      ],
      "./plugins/with-android-sdk"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
