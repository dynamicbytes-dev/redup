# ==============================================================================
# .dockerignore · Redup (Expo SDK 58 / Expo Router Web)
# Reduce drásticamente el contexto de build y evita filtrar secretos o nativos.
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencias y artefactos de gestores de paquetes locales
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Control de versiones, configuración de CI y metadatos git
# ------------------------------------------------------------------------------
.git/
.gitignore
.gitattributes
.github/

# ------------------------------------------------------------------------------
# Salidas de compilación previas y cachés temporales
# ------------------------------------------------------------------------------
dist/
build/
web-build/
.expo/
.expo-shared/
coverage/
.nyc_output/
*.lcov
*.tsbuildinfo
.metro-health-check*

# ------------------------------------------------------------------------------
# Carpetas nativas móviles y claves/certificados de firma
# (El contenedor Docker es exclusivo para la versión web)
# ------------------------------------------------------------------------------
android/
ios/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.cert
*.crt
*.mobileprovision
*.apk
*.aab
*.ipa
*.dmg

# ------------------------------------------------------------------------------
# Secretos y variables de entorno (NUNCA dentro de la imagen)
# Se pasan en tiempo de build o runtime según corresponda
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
service-account*.json
credentials*.json
google-services.json
GoogleService-Info.plist
fcm-service-account*.json
*firebase*.json
*livekit*.json

# ------------------------------------------------------------------------------
# Supabase local (migraciones, funciones edge y estado CLI)
# ------------------------------------------------------------------------------
supabase/
.supabase/

# ------------------------------------------------------------------------------
# Herramientas de despliegue móvil y scripts de testing local
# ------------------------------------------------------------------------------
eas.json
.eas/
scripts/

# ------------------------------------------------------------------------------
# Configuración de Docker y compose local
# ------------------------------------------------------------------------------
Dockerfile*
docker-compose*.yml
.dockerignore

# ------------------------------------------------------------------------------
# Documentación, licencias y configuración de editores
# ------------------------------------------------------------------------------
README.md
DEPLOYMENT.md
AGENTS.md
LICENSE
opencode.json
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ------------------------------------------------------------------------------
# Basura y metadatos de sistemas operativos (macOS / Windows / Linux)
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
