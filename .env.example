# Copia este archivo a `.env` con las credenciales de tu proyecto Supabase.
# En local las obtienes con: npx supabase status
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Configuración SMTP para recuperación de contraseñas y correos transaccionales
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
SMTP_ADMIN_EMAIL=tu-correo@gmail.com
SMTP_SENDER_NAME="RedUp"
