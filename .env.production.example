# ==============================================================================
# Redup · Variables de Entorno de Producción (plantilla)
# Copia este archivo a `.env.production` y completa los valores.
# En EAS Build configura las variables con:
#   eas env:create --name <KEY> --value <VALUE> --environment production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Cliente Móvil / Web)
# ------------------------------------------------------------------------------
# Proyecto de producción: redup projet (cctpntjrlduntjjpjpcb)
EXPO_PUBLIC_SUPABASE_URL=https://cctpntjrlduntjjpjpcb.supabase.co

# Clave pública anónima (legacy anon key). Obtener con:
#   npx supabase projects api-keys --project-ref cctpntjrlduntjjpjpcb
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Servidor web de producción (Nginx en el puerto 80 -> 127.0.0.1:3000)
# Añadir en Supabase Dashboard -> Authentication -> URL Configuration:
#   http://18.191.49.251/**
#   http://18.191.49.251/reset-password
# ------------------------------------------------------------------------------
PUBLIC_SERVER_URL=http://18.191.49.251

# ------------------------------------------------------------------------------
# 3. Supabase Edge Functions (Secrets en Supabase Cloud)
# supabase secrets set --env-file .env.production.secrets
# ------------------------------------------------------------------------------
# Clave service_role (NUNCA exponer en el bundle móvil)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secreto para autorizar webhooks de base de datos a push-notify
PUSH_WEBHOOK_SECRET=generar_secreto_aleatorio_seguro_aqui

# ------------------------------------------------------------------------------
# 4. LiveKit Cloud / self-hosted (Llamadas de audio y video) — opcional
# ------------------------------------------------------------------------------
EXPO_PUBLIC_LIVEKIT_URL=wss://redup-prod.livekit.cloud
LIVEKIT_URL=wss://redup-prod.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=secxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. Proveedor Transaccional SMTP de Producción (Resend / SendGrid / Postmark)
# Configurar en Supabase Dashboard -> Project Settings -> Auth -> SMTP
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_1234567890abcdef
SMTP_ADMIN_EMAIL=notificaciones@tudominio.com
SMTP_SENDER_NAME="Redup"
